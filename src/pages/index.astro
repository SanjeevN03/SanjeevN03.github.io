---
import MainLayout from "../layouts/MainLayout.astro";
const services = [
["☀","On-Grid Solar","Generate clean electricity while staying connected to the utility grid."],
["◉","Off-Grid Solar","Independent solar power solutions for suitable sites."],
["↗","Hybrid Solar","Combine solar, grid supply and battery storage where suitable."],
["▥","Ground-Mounted Solar","Purpose-designed installations for suitable land and open sites."],
["⇄","Battery Storage (BESS)","Explore storage for backup, solar shifting and commercial energy needs."],
["♨","Solar Water Heating","Use solar thermal energy to support hot-water requirements."],
["≈","Heat Pump Water Heating","Efficient hot-water solutions for hotels, institutions and businesses."],
["⌁","Net Metering Assistance","Support with documentation, applications, follow-up and coordination."]
];
const industries = [
["Commercial Buildings","Solutions for offices, retail and business premises."],
["Schools & Colleges","Energy options planned around institutional usage."],
["Industrial Facilities","Solar and storage options for suitable industrial sites."],
["Hotels & Hospitality","Solar power and efficient hot-water solutions."],
["Hospitals & Healthcare","Energy planning for facilities with varied operating needs."],
["Homes & Housing Societies","Rooftop solutions tailored to site and consumption."]
];
const steps = [
["01","Understand","Discuss your usage, goals, site and budget."],["02","Survey","Review site conditions, shading and electrical setup."],
["03","Assess","Study consumption patterns and system requirements."],["04","Design","Prepare a suitable system concept and component selection."],
["05","Proposal","Share scope, specifications, costs and next steps."],["06","Install","Coordinate installation with care and attention to safety."],
["07","Commission","Carry out checks and system handover."],["08","Liaise","Assist with applicable documentation and net-metering steps."]
];
